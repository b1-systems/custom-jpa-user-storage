<?xml version="1.0" encoding="UTF-8"?>
<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
    version="3.0">
    <persistence-unit name="custom-jpa-user-datasource" transaction-type="JTA">
        <class>de.b1systems.keycloak.storage.user.ClientRoleEntity</class>
        <class>de.b1systems.keycloak.storage.user.RealmRoleEntity</class>
        <class>de.b1systems.keycloak.storage.user.UserEntity</class>
        <properties>
            <property
                name="jakarta.persistence.jtaDataSource"
                value="custom-jpa-user-datasource" />
            <property
                name="jakarta.persistence.transactionType"
                value="JTA" />
            <property
                name="hibernate.dialect"
                value="org.hibernate.dialect.PostgreSQLDialect" />
            <property
                name="hibernate.hbm2ddl.auto"
                value="none"/>
            <property
                name="hibernate.show_sql"
                value="true" />
        </properties>
    </persistence-unit>
</persistence>
